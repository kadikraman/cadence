{
  "name": "cadence-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bun run --cwd apps/cadence start",
    "ios": "bun run --cwd apps/cadence ios",
    "android": "bun run --cwd apps/cadence android",
    "web": "bun run --cwd apps/cadence web",
    "lint": "bun run --cwd apps/cadence lint",
    "test": "bun run --cwd apps/cadence test",
    "marketing": "bun run --cwd apps/marketing start",
    "marketing:build": "bun run --cwd apps/marketing build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "expo-updates-interface": "56.0.1"
  },
  "trustedDependencies": [
    "@sentry/cli",
    "react-native-nitro-modules",
    "unrs-resolver"
  ]
}
